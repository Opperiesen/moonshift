{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshift.dev/schemas/v2/conformance-profile.json",
  "title": "Moonshift Execution Backend Conformance Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "profileId",
    "profileVersion",
    "familyKind",
    "testOnly",
    "supportScope",
    "commonCaseIds",
    "familyCaseIds",
    "capabilityProfiles",
    "compatibility",
    "contentHash"
  ],
  "properties": {
    "contractVersion": { "const": "2.0" },
    "profileId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "profileVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "familyKind": {
      "enum": ["MODEL_API", "CODING_HARNESS", "LOCAL_RUNTIME", "DETERMINISTIC_FIXTURE"]
    },
    "testOnly": { "const": true },
    "supportScope": { "const": "TEST_FIXTURE_ONLY" },
    "commonCaseIds": { "$ref": "#/$defs/caseIds" },
    "familyCaseIds": { "$ref": "#/$defs/caseIds" },
    "capabilityProfiles": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/capabilityProfile" }
    },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "contentHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "caseId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{2,127}$" },
    "caseIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/caseId" }
    },
    "capabilityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "applicability", "mandatoryWhenClaimedCaseIds"],
      "properties": {
        "capabilityId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "applicability": { "const": "CLAIMED_CAPABILITY_ONLY" },
        "mandatoryWhenClaimedCaseIds": { "$ref": "#/$defs/caseIds" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportedContractVersions", "compatiblePriorProfileVersions"],
      "properties": {
        "supportedContractVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
        },
        "compatiblePriorProfileVersions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        }
      }
    }
  }
}
