{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshift.dev/schemas/v2/backend-catalog.json",
  "title": "Moonshift Backend Catalog Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "snapshotId",
    "backend",
    "adapterRelease",
    "connection",
    "probe",
    "health",
    "models",
    "relations",
    "contentHash"
  ],
  "properties": {
    "contractVersion": { "const": "2.0" },
    "snapshotId": { "$ref": "#/$defs/uuid" },
    "backend": { "$ref": "#/$defs/backendDescriptor" },
    "adapterRelease": { "$ref": "#/$defs/adapterRelease" },
    "connection": { "$ref": "#/$defs/connection" },
    "probe": { "$ref": "#/$defs/probeSnapshot" },
    "health": { "$ref": "#/$defs/healthSnapshot" },
    "models": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/modelDescriptor" }
    },
    "relations": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/connectionModelQualification" }
    },
    "contentHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "positiveVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "familyKind": {
      "enum": ["MODEL_API", "CODING_HARNESS", "LOCAL_RUNTIME", "DETERMINISTIC_FIXTURE"]
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
    },
    "backendDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backendId",
        "familyKind",
        "familyProfileId",
        "familyProfileVersion",
        "name",
        "testOnly",
        "supportScope",
        "lifecycle",
        "createdAt"
      ],
      "properties": {
        "backendId": { "$ref": "#/$defs/uuid" },
        "familyKind": { "$ref": "#/$defs/familyKind" },
        "familyProfileId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,127}$"
        },
        "familyProfileVersion": { "$ref": "#/$defs/positiveVersion" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "testOnly": { "const": true },
        "supportScope": { "const": "TEST_FIXTURE_ONLY" },
        "lifecycle": { "enum": ["ACTIVE", "DISABLED", "RETIRED"] },
        "createdAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "adapterRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterReleaseId",
        "backendId",
        "adapterName",
        "adapterVersion",
        "supportedContractRange",
        "supportedProfileRange",
        "implementationKind",
        "contentHash"
      ],
      "properties": {
        "adapterReleaseId": { "$ref": "#/$defs/uuid" },
        "backendId": { "$ref": "#/$defs/uuid" },
        "adapterName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,127}$"
        },
        "adapterVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "supportedContractRange": { "type": "string", "minLength": 1, "maxLength": 64 },
        "supportedProfileRange": { "type": "string", "minLength": 1, "maxLength": 128 },
        "implementationKind": { "const": "FIXTURE" },
        "contentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectionId",
        "backendId",
        "adapterReleaseId",
        "name",
        "configurationRevision",
        "authenticationMode",
        "authenticationStatus",
        "lifecycle",
        "updatedAt"
      ],
      "properties": {
        "connectionId": { "$ref": "#/$defs/uuid" },
        "backendId": { "$ref": "#/$defs/uuid" },
        "adapterReleaseId": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "configurationRevision": { "$ref": "#/$defs/positiveVersion" },
        "authenticationMode": { "const": "NONE_FIXTURE" },
        "authenticationStatus": {
          "enum": ["AVAILABLE", "UNAVAILABLE", "EXPIRED", "MISCONFIGURED", "UNKNOWN"]
        },
        "credentialReference": { "type": "null" },
        "lifecycle": { "enum": ["ENABLED", "DISABLED", "RETIRED"] },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "capabilityObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "scope",
        "requirement",
        "status",
        "source",
        "observedAt"
      ],
      "properties": {
        "capabilityId": { "$ref": "#/$defs/capabilityId" },
        "scope": { "enum": ["FAMILY", "CONNECTION", "MODEL", "EXECUTION"] },
        "requirement": { "enum": ["MANDATORY", "OPTIONAL"] },
        "status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "TEMPORARILY_UNAVAILABLE",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "source": { "enum": ["DECLARED", "PROBED", "CONFORMANCE"] },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "evidenceHash": { "$ref": "#/$defs/hash" }
      }
    },
    "probeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probeSnapshotId",
        "connectionId",
        "configurationRevision",
        "adapterReleaseId",
        "probeLeaseId",
        "fencingToken",
        "observedAt",
        "validUntil",
        "authenticationStatus",
        "capabilities",
        "contentHash"
      ],
      "properties": {
        "probeSnapshotId": { "$ref": "#/$defs/uuid" },
        "connectionId": { "$ref": "#/$defs/uuid" },
        "configurationRevision": { "$ref": "#/$defs/positiveVersion" },
        "adapterReleaseId": { "$ref": "#/$defs/uuid" },
        "probeLeaseId": { "$ref": "#/$defs/uuid" },
        "fencingToken": { "type": "string", "pattern": "^[1-9][0-9]{0,38}$" },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "validUntil": { "$ref": "#/$defs/timestamp" },
        "authenticationStatus": {
          "enum": ["AVAILABLE", "UNAVAILABLE", "EXPIRED", "MISCONFIGURED", "UNKNOWN"]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/capabilityObservation" }
        },
        "normalizedFailureCode": { "$ref": "#/$defs/reasonCode" },
        "contentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "healthSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "healthSnapshotId",
        "connectionId",
        "configurationRevision",
        "adapterReleaseId",
        "probeLeaseId",
        "fencingToken",
        "observedAt",
        "validUntil",
        "source",
        "liveness",
        "readiness",
        "contentHash"
      ],
      "properties": {
        "healthSnapshotId": { "$ref": "#/$defs/uuid" },
        "connectionId": { "$ref": "#/$defs/uuid" },
        "configurationRevision": { "$ref": "#/$defs/positiveVersion" },
        "adapterReleaseId": { "$ref": "#/$defs/uuid" },
        "probeLeaseId": { "$ref": "#/$defs/uuid" },
        "fencingToken": { "type": "string", "pattern": "^[1-9][0-9]{0,38}$" },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "validUntil": { "$ref": "#/$defs/timestamp" },
        "source": { "enum": ["PROBE", "HEARTBEAT"] },
        "liveness": { "enum": ["LIVE", "UNREACHABLE", "UNKNOWN"] },
        "readiness": { "enum": ["READY", "DEGRADED", "NOT_READY", "UNKNOWN"] },
        "normalizedFailureCode": { "$ref": "#/$defs/reasonCode" },
        "contentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "modelDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelDescriptorId",
        "backendId",
        "version",
        "canonicalName",
        "familyProfileId",
        "familyProfileVersion",
        "declaredCapabilities",
        "provenance",
        "contentHash"
      ],
      "properties": {
        "modelDescriptorId": { "$ref": "#/$defs/uuid" },
        "backendId": { "$ref": "#/$defs/uuid" },
        "version": { "$ref": "#/$defs/positiveVersion" },
        "canonicalName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "familyProfileId": { "type": "string", "minLength": 3, "maxLength": 128 },
        "familyProfileVersion": { "$ref": "#/$defs/positiveVersion" },
        "declaredCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/capabilityId" }
        },
        "limits": { "$ref": "#/$defs/modelLimits" },
        "provenance": { "$ref": "#/$defs/modelProvenance" },
        "contentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "modelLimits": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "dependentRequired": {
        "maxInputUnits": ["unit"],
        "maxOutputUnits": ["unit"]
      },
      "properties": {
        "maxInputUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxOutputUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "unit": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
        },
        "inputModalities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": { "enum": ["TEXT", "IMAGE", "AUDIO", "VIDEO", "EMBEDDING"] }
        },
        "outputModalities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": { "enum": ["TEXT", "IMAGE", "AUDIO", "VIDEO", "EMBEDDING"] }
        }
      }
    },
    "modelProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discoverySource",
        "adapterReleaseId",
        "configurationRevision",
        "observedAt",
        "probeSnapshotId"
      ],
      "properties": {
        "discoverySource": { "enum": ["FIXTURE_MANIFEST", "ADAPTER_DISCOVERY"] },
        "adapterReleaseId": { "$ref": "#/$defs/uuid" },
        "configurationRevision": { "$ref": "#/$defs/positiveVersion" },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "probeSnapshotId": { "$ref": "#/$defs/uuid" }
      }
    },
    "connectionModelQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualificationId",
        "connectionId",
        "configurationRevision",
        "modelDescriptorId",
        "modelDescriptorVersion",
        "familyProfileId",
        "familyProfileVersion",
        "status",
        "capabilities",
        "probeSnapshotId",
        "healthSnapshotId",
        "conformanceReportId",
        "reasonCodes",
        "derivedAt",
        "validUntil",
        "derivationVersion",
        "contentHash"
      ],
      "properties": {
        "qualificationId": { "$ref": "#/$defs/uuid" },
        "connectionId": { "$ref": "#/$defs/uuid" },
        "configurationRevision": { "$ref": "#/$defs/positiveVersion" },
        "modelDescriptorId": { "$ref": "#/$defs/uuid" },
        "modelDescriptorVersion": { "$ref": "#/$defs/positiveVersion" },
        "familyProfileId": { "type": "string", "minLength": 3, "maxLength": 128 },
        "familyProfileVersion": { "$ref": "#/$defs/positiveVersion" },
        "status": { "enum": ["QUALIFIED", "INELIGIBLE", "STALE", "UNKNOWN"] },
        "capabilities": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/capabilityObservation" }
        },
        "probeSnapshotId": { "$ref": "#/$defs/uuid" },
        "healthSnapshotId": { "$ref": "#/$defs/uuid" },
        "conformanceReportId": { "$ref": "#/$defs/uuid" },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/reasonCode" }
        },
        "derivedAt": { "$ref": "#/$defs/timestamp" },
        "validUntil": { "$ref": "#/$defs/timestamp" },
        "derivationVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "contentHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
