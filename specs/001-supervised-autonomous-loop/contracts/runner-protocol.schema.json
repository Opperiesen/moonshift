{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshift.dev/schemas/v1/runner-message.json",
  "title": "Moonshift Fixture Runner Protocol Message",
  "$comment": "Schema validity is necessary but not authentication. Every message is accepted only on the mutually authenticated runner transport defined in contracts/README.md; instanceId MUST match the enrolled control-plane certificate and runnerId MUST match the daemon identity authenticated by its runner certificate.",
  "oneOf": [
    { "$ref": "#/$defs/register" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/leaseOffer" },
    { "$ref": "#/$defs/fixtureCommand" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/reconcile" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "resourceCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureOperations", "arbitraryShell", "maxJobs", "memoryBytes", "cpuUnits",
        "processLimit", "diskBytes", "maxRuntimeMs", "networkMode", "gpuUnits", "enforcement"
      ],
      "properties": {
        "fixtureOperations": { "const": true },
        "arbitraryShell": { "const": false },
        "maxJobs": { "const": 1 },
        "memoryBytes": { "type": "integer", "minimum": 134217728 },
        "cpuUnits": { "type": "integer", "minimum": 1 },
        "processLimit": { "type": "integer", "minimum": 1 },
        "diskBytes": { "type": "integer", "minimum": 1048576 },
        "maxRuntimeMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "networkMode": { "const": "DENY" },
        "gpuUnits": { "type": "integer", "minimum": 0 },
        "enforcement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory", "process", "disk", "time", "network", "gpu"],
          "properties": {
            "cpu": { "type": "boolean" },
            "memory": { "type": "boolean" },
            "process": { "type": "boolean" },
            "disk": { "type": "boolean" },
            "time": { "type": "boolean" },
            "network": { "type": "boolean" },
            "gpu": { "type": "boolean" }
          }
        }
      }
    },
    "resourceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryBytes", "cpuUnits", "processLimit", "diskBytes", "maxRuntimeMs", "networkMode", "gpuUnits"],
      "properties": {
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "cpuUnits": { "type": "integer", "minimum": 1 },
        "processLimit": { "type": "integer", "minimum": 1 },
        "diskBytes": { "type": "integer", "minimum": 1 },
        "maxRuntimeMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "networkMode": { "const": "DENY" },
        "gpuUnits": { "const": 0 }
      }
    },
    "runtimeDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cgroupVersion", "subordinateUidRange", "subordinateGidRange", "rootlessRuntime",
        "rootlessNetwork", "storageDriver", "filesystemType", "supportsRootlessOci"
      ],
      "properties": {
        "cgroupVersion": { "type": "string", "enum": ["NONE", "V1", "V2"] },
        "subordinateUidRange": { "type": "boolean" },
        "subordinateGidRange": { "type": "boolean" },
        "rootlessRuntime": { "type": "string", "enum": ["NOT_PROBED", "UNAVAILABLE", "PODMAN"] },
        "rootlessNetwork": { "type": "string", "enum": ["NOT_PROBED", "UNAVAILABLE", "PASTA", "SLIRP4NETNS"] },
        "storageDriver": { "type": "string", "enum": ["NOT_PROBED", "UNAVAILABLE", "OVERLAY", "FUSE_OVERLAYFS"] },
        "filesystemType": { "type": "string", "enum": ["APFS", "BTRFS", "EXT4", "XFS", "OTHER_UNSUPPORTED"] },
        "supportsRootlessOci": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "supportsRootlessOci": { "const": true } }, "required": ["supportsRootlessOci"] },
          "then": {
            "properties": {
              "cgroupVersion": { "const": "V2" },
              "subordinateUidRange": { "const": true },
              "subordinateGidRange": { "const": true },
              "rootlessRuntime": { "const": "PODMAN" },
              "rootlessNetwork": { "enum": ["PASTA", "SLIRP4NETNS"] },
              "storageDriver": { "enum": ["OVERLAY", "FUSE_OVERLAYFS"] },
              "filesystemType": { "enum": ["BTRFS", "EXT4", "XFS"] }
            }
          }
        }
      ]
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "kind", "instanceId", "runnerId", "correlationId", "sentAt",
        "runnerVersion", "certificateSerial", "profile", "capabilities", "runtimeDiscovery"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "kind": { "const": "runner.register" },
        "instanceId": { "$ref": "#/$defs/uuid" },
        "runnerId": { "$ref": "#/$defs/uuid" },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "sentAt": { "type": "string", "format": "date-time" },
        "runnerVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "certificateSerial": { "type": "string", "pattern": "^[A-F0-9]{2,64}$" },
        "profile": { "const": "FIXTURE_PROCESS" },
        "capabilities": { "$ref": "#/$defs/resourceCapacity" },
        "runtimeDiscovery": { "$ref": "#/$defs/runtimeDiscovery" }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "messageId", "kind", "instanceId", "runnerId", "correlationId", "sentAt", "activeLeaseIds"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "kind": { "const": "runner.heartbeat" },
        "instanceId": { "$ref": "#/$defs/uuid" },
        "runnerId": { "$ref": "#/$defs/uuid" },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "sentAt": { "type": "string", "format": "date-time" },
        "activeLeaseIds": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "leaseOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "kind", "instanceId", "runnerId", "correlationId", "sentAt",
        "leaseId", "executionId", "fencingToken", "expiresAt", "resources"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "kind": { "const": "runner.lease_offer" },
        "instanceId": { "$ref": "#/$defs/uuid" },
        "runnerId": { "$ref": "#/$defs/uuid" },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "sentAt": { "type": "string", "format": "date-time" },
        "leaseId": { "$ref": "#/$defs/uuid" },
        "executionId": { "$ref": "#/$defs/uuid" },
        "fencingToken": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "resources": { "$ref": "#/$defs/resourceRequest" }
      }
    },
    "fixtureCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "kind", "instanceId", "runnerId", "correlationId", "sentAt",
        "leaseId", "executionId", "fencingToken", "operation", "effectId", "actionDigest"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "kind": { "const": "runner.run_fixture" },
        "instanceId": { "$ref": "#/$defs/uuid" },
        "runnerId": { "$ref": "#/$defs/uuid" },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "sentAt": { "type": "string", "format": "date-time" },
        "leaseId": { "$ref": "#/$defs/uuid" },
        "executionId": { "$ref": "#/$defs/uuid" },
        "fencingToken": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "operation": { "const": "WRITE_APPROVED_MARKER" },
        "effectId": { "$ref": "#/$defs/uuid" },
        "actionDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "kind", "instanceId", "runnerId", "correlationId", "sentAt",
        "leaseId", "executionId", "fencingToken", "reason"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "kind": { "const": "runner.cancel" },
        "instanceId": { "$ref": "#/$defs/uuid" },
        "runnerId": { "$ref": "#/$defs/uuid" },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "sentAt": { "type": "string", "format": "date-time" },
        "leaseId": { "$ref": "#/$defs/uuid" },
        "executionId": { "$ref": "#/$defs/uuid" },
        "fencingToken": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "reconcile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "kind", "instanceId", "runnerId", "correlationId", "sentAt",
        "effectId", "actionDigest"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "kind": { "const": "runner.reconcile" },
        "instanceId": { "$ref": "#/$defs/uuid" },
        "runnerId": { "$ref": "#/$defs/uuid" },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "sentAt": { "type": "string", "format": "date-time" },
        "effectId": { "$ref": "#/$defs/uuid" },
        "actionDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "kind", "instanceId", "runnerId", "correlationId", "sentAt",
        "operationMessageId", "leaseId", "executionId", "fencingToken", "outcome", "groundTruthDigest"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "kind": { "const": "runner.result" },
        "instanceId": { "$ref": "#/$defs/uuid" },
        "runnerId": { "$ref": "#/$defs/uuid" },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "sentAt": { "type": "string", "format": "date-time" },
        "operationMessageId": { "$ref": "#/$defs/uuid" },
        "leaseId": { "$ref": "#/$defs/uuid" },
        "executionId": { "$ref": "#/$defs/uuid" },
        "fencingToken": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "outcome": {
          "type": "string",
          "enum": ["APPLIED", "NOT_APPLIED", "ALREADY_APPLIED", "INDETERMINATE", "REJECTED_STALE_FENCE", "CANCELLED"]
        },
        "groundTruthDigest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
