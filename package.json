{
  "name": "moonshift",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Self-hosted autonomous software development under one human supervisor.",
  "homepage": "https://github.com/Opperiesen/moonshift#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Opperiesen/moonshift.git"
  },
  "bugs": {
    "url": "https://github.com/Opperiesen/moonshift/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node scripts/clean.mjs",
    "compose:check": "node scripts/check-compose-images.mjs",
    "contracts:generate": "node scripts/generate-contract-types.mjs",
    "contracts:validate": "vitest run --project contract",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint eslint.config.js scripts/**/*.mjs && node scripts/check-boundaries.mjs",
    "lockfile:check": "node scripts/check-lockfile.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:recovery": "vitest run --project recovery",
    "test:crash-matrix": "vitest run --project recovery tests/recovery/effect-crash-matrix.test.ts",
    "test:runner": "vitest run --project integration tests/integration/runner-authentication.test.ts",
    "test:migration": "vitest run --project recovery tests/recovery/backup-restore.test.ts -t migration",
    "test:restore": "vitest run --project recovery tests/recovery/backup-restore.test.ts",
    "test:security": "vitest run --project security",
    "test:capacity": "MOONSHIFT_CAPACITY_REPORT=test-results/reference-capacity.json vitest run --project performance",
    "test:acceptance": "playwright test",
    "test:foundation": "pnpm test:unit && pnpm test:contract && pnpm test:integration && pnpm test:recovery && pnpm test:security && pnpm test:capacity",
    "typecheck": "tsc -b --pretty false",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sourcemeta/jsonschema": "16.8.0",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
